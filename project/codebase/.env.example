# OpenAI API key (agent.py / eval --llm đọc biến này)
OPENAI_API_KEY=sk-your-key-here

# Model (tùy chọn). Ví dụ hợp lệ: gpt-4o-mini, gpt-3.5-turbo, gpt-4o
# Sai: gpt-4.0-mini (không tồn tại)
OPENAI_MODEL=gpt-4o-mini

# Alias cũ — vẫn được map sang OPENAI_API_KEY nếu biến trên chưa set
# API_KEY_ORDER=...
OPENAI_API_KEY=
OPENMAP_API_KEY=
API_KEY_OPENAI=your_API_key
